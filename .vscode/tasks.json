{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "[ UBUNTU ] Security Scan",
            "type": "shell",
            "command": "trivy fs .",
            "group": {
                "kind": "test"
            }
        },
        {
            "label": "[ UBUNTU ] Clean The Solution",
            "type": "shell",
            "command": "dotnet clean && rm -rf IDC.Template/bin/* && rm -rf IDC.Utilities/bin/*",
            "group": {
                "kind": "build"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "[ UBUNTU ] Build The Solution",
            "type": "shell",
            "command": "chmod +x ./.vscode/build.sh && ./.vscode/build.sh",
            "group": {
                "kind": "build"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "[ UBUNTU ] Rebuild The Solution",
            "type": "shell",
            "command": "chmod +x ./.vscode/rebuild.sh && ./.vscode/rebuild.sh",
            "group": {
                "kind": "build"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "[ WINDOWS ] Security Scan",
            "type": "shell",
            "command": "trivy fs .",
            "group": {
                "kind": "test"
            }
        },
        {
            "label": "[ WINDOWS ] Clean The Solution",
            "type": "shell",
            "command": "./.vscode/clean.bat",
            "group": {
                "kind": "build"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "[ WINDOWS ] Build The Solution",
            "type": "shell",
            "command": "./.vscode/build.bat",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "[ WINDOWS ] Rebuild The Solution",
            "type": "shell",
            "command": "./.vscode/rebuild.bat",
            "group": {
                "kind": "build"
            },
            "problemMatcher": "$msCompile"
        }
    ]
}